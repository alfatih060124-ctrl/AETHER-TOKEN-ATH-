# Never commit a real private key.
PRIVATE_KEY=0xYOUR_TESTNET_DEPLOYER_PRIVATE_KEY
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com

# Testnet-only simplification.
# When true on BSC Testnet, all operational allocation/owner roles resolve to
# the deployer address. This flag is ignored for Mainnet.
TESTNET_USE_DEPLOYER_ROLES=false

# One-shot BSC Testnet transaction gate.
# Keep false until the dedicated Testnet PRIVATE_KEY is present and funded.
TESTNET_DEPLOY_APPROVED=false

# Explicit operational role addresses.
# Token + Price Registry use PRESALE_OWNER_ADDRESS so the Token & Presale
# workspace is controlled by one dedicated wallet.
MINING_OWNER_ADDRESS=0xATH_MINING_ADMIN
STAKING_OWNER_ADDRESS=0xATH_STAKING_ADMIN
PRESALE_OWNER_ADDRESS=0xATH_PRESALE_AND_TOKEN_ADMIN
KEEPER_WALLET_ADDRESS=0xATH_AUTOMATION_KEEPER
# Five-wallet layout: Mining owner is also the initial Mining revenue treasury.
PRESALE_WALLET=0xATH_PRESALE_PAYMENT_TREASURY
PRESALE_PAYMENT_TOKEN=0xSTABLECOIN_PAYMENT_TOKEN
LIQUIDITY_WALLET=0xATH_STAKING_LIQUIDITY_WALLET
STAKING_RESERVE_WALLET=0xATH_STAKING_RESERVE_WALLET
DEVELOPMENT_BENEFICIARY=0xATH_DEVELOPMENT_BENEFICIARY

# Runtime adapter
ATH_TOKEN_ADDRESS=0xDEPLOYED_ATH_TOKEN
ATH_PRICE_REGISTRY_ADDRESS=0xDEPLOYED_ATH_PRICE_REGISTRY
ATH_PRESALE_ADDRESS=0xDEPLOYED_ATH_PRESALE
ATH_MINING_ADDRESS=0xDEPLOYED_MINING_AIRDROP
ATH_STAKING_ADDRESS=0xDEPLOYED_ATH_STAKING
ATH_STAKING_ORACLE_ADDRESS=0xDEPLOYED_ATH_STAKING_ORACLE
ATH_DEVELOPMENT_VESTING_ADDRESS=0xDEPLOYED_ATH_DEVELOPMENT_VESTING
ATH_CHAIN_ID=97
ATH_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Fail-closed mainnet gates. Keep false until independent audit and launch gates are complete.
ALLOW_MAINNET_DEPLOY=false
MAINNET_AUDIT_PASSED=false
MAINNET_MULTISIG_CONFIRMED=false
LIQUIDITY_LOCK_CONFIRMED=false


# Rank salary keeper — fail-closed by default.
# Intended production cadence: once daily around 00:30 UTC; the contract itself only pays accounts whose weekly slot is due.
RUN_ATH_RANK_SALARY_KEEPER=false
RANK_KEEPER_ENABLED=false
RANK_KEEPER_DRY_RUN=true
RANK_KEEPER_SCHEDULE_GUARD=true
RANK_KEEPER_BATCH_SIZE=25
RANK_KEEPER_PAGE_SIZE=200
RANK_KEEPER_MIN_BNB=0.005


# Staking daily reward keeper — 00:50 UTC, fail-closed by default.
STAKING_REWARD_KEEPER_ENABLED=false
STAKING_REWARD_KEEPER_DRY_RUN=true
STAKING_REWARD_KEEPER_SCHEDULE_GUARD=true
STAKING_REWARD_KEEPER_BATCH_SIZE=25
STAKING_REWARD_KEEPER_PAGE_SIZE=200
STAKING_REWARD_KEEPER_MIN_BNB=0.005
