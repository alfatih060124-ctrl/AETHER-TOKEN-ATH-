PORT=8080
BOT_ENABLED=false

# Create the bot through official @BotFather and store secrets only in Railway.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

ATH_CAMPAIGN_LABEL=ATH Airdrop
AETHER_APP_URL=
AETHER_COMMUNITY_URL=
AETHER_WEBSITE_URL=

# Read-only ATH referral bridge.
# No blockchain private key belongs in this bot service.
ATH_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ATH_CHAIN_ID=97
ATH_MINING_ADDRESS=

# Community administration
ADMIN_TELEGRAM_IDS=
TARGET_CHAT_IDS=
COMMUNITY_FEATURES_ENABLED=true
JOIN_VERIFICATION_ENABLED=true
MIN_CRYPTO_SCORE=60
FLOOD_LIMIT=5
FLOOD_WINDOW_SECONDS=10
SOFT_PROMO_HOURS=8
ARTICLE_HOUR_UTC=9

# Opt-in growth campaign.
# Source chats must be crypto communities where the bot is explicitly allowed to post.
# The bot never scrapes users and never sends unsolicited direct messages.
GROWTH_CAMPAIGN_ENABLED=false
GROWTH_SOURCE_CHAT_IDS=
GROWTH_COUNTRY_CODES=BR,NG,IN,ID,VN,PH,UA,TH,ZA,TR,US,JP,KR,MX,CA
GROWTH_DAILY_TARGET_MIN=15
GROWTH_DAILY_TARGET_MAX=25
GROWTH_PULSE_HOURS=4

# Recommended for durable referral/campaign records.
# Without DATABASE_URL, the bot uses temporary in-memory storage.
DATABASE_URL=
PGSSL=

# Optional AI community replies. Keep disabled until an API key is configured.
AI_REPLY_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RANDOM_REPLY_RATE=0.08

# Never place blockchain private keys or seed phrases in the Telegram bot service.
