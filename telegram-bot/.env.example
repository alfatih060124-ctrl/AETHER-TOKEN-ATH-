PORT=8080
BOT_ENABLED=false

# Create this bot through Telegram @BotFather and store the token only in Railway.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

ATH_CAMPAIGN_LABEL=ATH Airdrop
AETHER_APP_URL=
AETHER_COMMUNITY_URL=
AETHER_WEBSITE_URL=

# Read-only ATH referral bridge.
# No blockchain private key belongs in this bot service.
ATH_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ATH_CHAIN_ID=97
ATH_MINING_ADDRESS=

# Comma-separated Telegram numeric user IDs allowed to use admin commands.
ADMIN_TELEGRAM_IDS=

# Recommended for durable referral/campaign records.
# Without DATABASE_URL, the bot uses temporary in-memory storage.
DATABASE_URL=
PGSSL=

# Never place blockchain private keys or seed phrases in the Telegram bot service.
