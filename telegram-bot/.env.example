PORT=8080
BOT_ENABLED=false

# Create the bot through official @BotFather and store secrets only in Railway.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

ATH_CAMPAIGN_LABEL=ATH Airdrop
AETHER_APP_URL=
AETHER_COMMUNITY_URL=
AETHER_WEBSITE_URL=

# Read-only ATH referral bridge.
# No blockchain private key belongs in this bot service.
ATH_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ATH_CHAIN_ID=97
ATH_MINING_ADDRESS=

# Community administration
ADMIN_TELEGRAM_IDS=
TARGET_CHAT_IDS=
COMMUNITY_FEATURES_ENABLED=true
JOIN_VERIFICATION_ENABLED=true
MIN_CRYPTO_SCORE=60
FLOOD_LIMIT=5
FLOOD_WINDOW_SECONDS=10
SOFT_PROMO_HOURS=8
ARTICLE_HOUR_UTC=2

# Recommended for durable referral/campaign records.
# Without DATABASE_URL, the bot uses temporary in-memory storage.
DATABASE_URL=
PGSSL=

# Optional future AI module. Do not set until the AI reply module is enabled.
OPENAI_API_KEY=

# Never place blockchain private keys or seed phrases in the Telegram bot service.
