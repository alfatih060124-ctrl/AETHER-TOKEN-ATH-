{
  "name": "aether-ath-engine",
  "version": "3.2.0",
  "private": true,
  "description": "AETHER TOKEN (ATH) Mining Engine aligned to Mining System Blueprint v3.1",
  "scripts": {
    "start": "node scripts/ci-server.js",
    "source:selfcheck": "node scripts/source-selfcheck.js",
    "syntax:check": "node --check scripts/preflight.js && node --check scripts/deploy.js && node --check scripts/verify.js && node --check scripts/rpc-check.js && node --check scripts/readiness-report.js && node --check scripts/postdeploy-check.js",
    "rpc:check:testnet": "node scripts/rpc-check.js",
    "readiness:testnet": "node scripts/readiness-report.js",
    "preflight:testnet": "node scripts/preflight.js testnet",
    "preflight:mainnet": "node scripts/preflight.js mainnet",
    "postdeploy:testnet": "node scripts/postdeploy-check.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bscMainnet",
    "verify:testnet": "hardhat run scripts/verify.js --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify.js --network bscMainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20 <23"
  }
}
